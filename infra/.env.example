# Copy to infra/.env and change the passwords. The .env file is git-ignored.
# Passwords are used only on the private compose network, but keep them non-trivial.
# They are applied when the Postgres volume is first created; changing them later needs a new volume.
PG_SUPER_PASSWORD=change-me-super
PS_REPL_PASSWORD=change-me-repl
PS_STORAGE_PASSWORD=change-me-storage
API_DB_PASSWORD=change-me-api

# Where the API is published on the host. Leave as is for the tailscale serve setup.
# API_PUBLISH=127.0.0.1:8080
